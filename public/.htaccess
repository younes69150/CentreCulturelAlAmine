Options -Indexes
RewriteEngine On

# Forcer HTTPS
RewriteCond %{HTTPS} off
RewriteCond %{HTTP:X-Forwarded-Proto} !https
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^ index.php [QSA,L]

# Compression des fichiers texte
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/javascript application/xml image/svg+xml application/manifest+json
</IfModule>

# Cache navigateur : 30 jours pour polices et images, 7 jours pour CSS et JS
<IfModule mod_headers.c>
    <FilesMatch "\.(woff2|png|jpg|webp|svg|ico)$">
        Header set Cache-Control "public, max-age=2592000"
    </FilesMatch>
    <FilesMatch "\.(css|js|webmanifest)$">
        Header set Cache-Control "public, max-age=604800"
    </FilesMatch>
</IfModule>

AddType application/manifest+json .webmanifest
